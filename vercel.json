{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "cd web && npm install",
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:jpg|jpeg|png|svg|webp|ico))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/predictions", "destination": "/dashboard", "permanent": true },
    { "source": "/football", "destination": "/dashboard", "permanent": true },
    { "source": "/analytics", "destination": "/dashboard", "permanent": true },
    { "source": "/dashboard/predictions", "destination": "/dashboard", "permanent": true },
    { "source": "/dashboard/football", "destination": "/dashboard", "permanent": true },
    { "source": "/goals", "destination": "/dashboard/goals", "permanent": true },
    { "source": "/other-markets", "destination": "/dashboard/goals", "permanent": true },
    { "source": "/over-2-5", "destination": "/dashboard/goals", "permanent": true },
    { "source": "/tennis", "destination": "/dashboard/tennis", "permanent": true },
    { "source": "/basketball", "destination": "/dashboard/basketball", "permanent": true },
    { "source": "/american-football", "destination": "/dashboard/american-football", "permanent": true },
    { "source": "/cricket", "destination": "/dashboard/cricket", "permanent": true },
    { "source": "/dashboard/track-record", "destination": "/track-record", "permanent": true },
    { "source": "/settlement", "destination": "/track-record", "permanent": true },
    { "source": "/pricing", "destination": "/subscription", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/ssr?path=/" },
    { "source": "/dashboard", "destination": "/api/ssr?path=/dashboard" },
    {
      "source": "/dashboard/:page(goals|tennis|basketball|american-football|cricket)",
      "destination": "/api/ssr?path=/dashboard/:page"
    },
    { "source": "/track-record", "destination": "/api/ssr?path=/track-record" },
    { "source": "/subscription", "destination": "/api/ssr?path=/subscription" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/((?!api/).*)",
      "destination": "/app-shell.html"
    }
  ]
}
