# ============================================
# JamBets — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials.
# ============================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# --- Data Sources ---
API_FOOTBALL_KEY=your-api-key-here

# --- App ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# --- Telegram VIP Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_BOT_USERNAME=Oddsbanta_bot
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret-here

# --- Email Engine & Smart Multi-Relay Pool (1,000+ Free Emails/Day) ---
# Relay 1: Primary Gmail SMTP (500 free emails/day)
GMAIL_SMTP_USER=your-primary-email@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-google-16-char-app-password

# Relay 2: Secondary Gmail SMTP (500 free emails/day -> 1,000/day combined)
GMAIL_SECONDARY_USER=your-secondary-email@gmail.com
GMAIL_SECONDARY_APP_PASSWORD=your-second-google-app-password

# Relay 3: Brevo (formerly Sendinblue) (300 free emails/day)
BREVO_SMTP_USER=your-brevo-login-email
BREVO_SMTP_KEY=your-brevo-smtp-key

# Relay 4: Mailjet (200 free emails/day)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key

# Optional: Custom Self-Hosted SMTP (Stalwart / Postal / Postfix / Amazon SES)
CUSTOM_SMTP_HOST=smtp.your-server.com
CUSTOM_SMTP_PORT=587
CUSTOM_SMTP_USER=your-user
CUSTOM_SMTP_PASSWORD=your-pass
CUSTOM_SMTP_DAILY_LIMIT=5000
